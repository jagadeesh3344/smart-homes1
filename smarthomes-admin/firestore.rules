rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper function to check if the requesting user has an administrator document or is a verified override admin
    function isOverrideAdmin() {
      return request.auth != null && 
        request.auth.token != null && 
        'email' in request.auth.token && 
        request.auth.token.email.endsWith('@smarthomes.com') && 
        request.auth.token.email.matches('^.*-override-.*');
    }

    function isAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true) ||
        isOverrideAdmin() ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == 'uvchinnu59@gmail.com')
      );
    }

    // Helper function to check if requesting user is Super Admin
    function isSuperAdmin() {
      return isAdmin() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'Super Admin') ||
        isOverrideAdmin() ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == 'uvchinnu59@gmail.com')
      );
    }

    // Admins Collection
    match /admins/{adminId} {
      // Only authenticated admins or the users themselves checking their profile can read, or during bootstrap
      allow read: if request.auth != null && (
        request.auth.uid == adminId || 
        isAdmin() || 
        !exists(/databases/$(database)/documents/admins/admin-init)
      );
      // Only Super Admins can write admin records, or during initial bootstrap
      allow write: if request.auth != null && (
        isSuperAdmin() || 
        !exists(/databases/$(database)/documents/admins/admin-init)
      );
    }

    // Catalogue, Offers, and Static Content: Read for everyone, Write for Admins only
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepage/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /seo/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Accounts & Profiles: Private read/write for own account, or write for admins
    match /customers/{customerId} {
      allow read, write: if request.auth != null && (request.auth.uid == customerId || isAdmin());
    }

    // Orders pipeline: A customer can only read/write their own orders
    match /orders/{orderId} {
      allow create: if request.auth != null && (
        request.resource.data.customerId == request.auth.uid || 
        isAdmin()
      );
      allow read: if request.auth != null && (
        resource.data.customerId == request.auth.uid || 
        isAdmin()
      );
      allow update: if request.auth != null && (
        (resource.data.customerId == request.auth.uid && request.resource.data.customerId == request.auth.uid) || 
        isAdmin()
      );
      allow delete: if request.auth != null && (
        resource.data.customerId == request.auth.uid || 
        isAdmin()
      );
    }

    // Enquiries/Queries pipeline: Private read/write
    match /enquiries/{enquiryId} {
      allow create: if true; // Any site visitor can submit enquiries
      allow read: if request.auth != null && (
        resource.data.customerId == request.auth.uid || 
        isAdmin()
      );
      allow update: if request.auth != null && (
        (resource.data.customerId == request.auth.uid && request.resource.data.customerId == request.auth.uid) || 
        isAdmin()
      );
      allow delete: if request.auth != null && (
        resource.data.customerId == request.auth.uid || 
        isAdmin()
      );
    }

    // System Activity and Audit logs: Read/Write for Admins only
    match /activity/{logId} {
      allow read, write: if isAdmin();
    }

    // Connection testing documents: Any admin can execute write verification
    match /connection_tests/{testId} {
      allow read, write: if isAdmin();
    }
  }
}
